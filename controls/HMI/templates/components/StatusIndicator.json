{
  "templateType": "component",
  "name": "StatusIndicator",
  "version": "1.0.0",
  "description": "ISA-101 compliant status indicator",
  "parameters": {
    "state": {
      "type": "string",
      "required": true,
      "enum": ["running", "stopped", "manual", "auto", "maintenance", "fault"],
      "description": "Current equipment state"
    },
    "label": {
      "type": "string",
      "required": true,
      "description": "Display text"
    },
    "showDot": {
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Show status dot indicator"
    },
    "size": {
      "type": "string",
      "required": false,
      "default": "medium",
      "enum": ["small", "medium", "large"],
      "description": "Size of the indicator"
    }
  },
  "template": {
    "type": "ia.display.state-indicator",
    "version": "1.0.0",
    "props": {
      "state": "{state}",
      "text": "{label}",
      "style": {
        "fontSize": "{size === 'small' ? '12px' : size === 'large' ? '16px' : '14px'}",
        "padding": "{size === 'small' ? '4px 8px' : size === 'large' ? '10px 20px' : '6px 12px'}"
      }
    },
    "meta": {
      "name": "StatusIndicator_{label}"
    }
  },
  "stateColors": {
    "running": "var(--state-running)",
    "stopped": "var(--state-stopped)",
    "manual": "var(--state-manual)",
    "auto": "var(--state-auto)",
    "maintenance": "var(--state-maintenance)",
    "fault": "var(--state-fault)"
  },
  "example": {
    "state": "running",
    "label": "ONLINE",
    "showDot": true,
    "size": "medium"
  }
}
